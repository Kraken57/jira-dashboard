# Optional: Jira Cloud REST API credentials for live localhost fetching
# If left blank, the app uses the bundled 5-pod enterprise dataset (CRM, DTP, ERP, SEC, SRG)
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email-id
JIRA_API_TOKEN=your-jira-api-token

# Base URL for API requests (leave blank for local Next.js /api routes)
NEXT_PUBLIC_API_BASE_URL=


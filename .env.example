# === Required: Jira Cloud REST API credentials ===
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# NOTE: these are per-site AND per-machine. Each computer needs its own token
# for the Jira site it talks to.
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email-id
JIRA_API_TOKEN=your-jira-api-token

# === Optional: Base URL for API requests ===
# Leave blank for local Next.js /api routes
NEXT_PUBLIC_API_BASE_URL=

# === Optional: Which Jira data to pull ===
# Change project keys to point at a different dashboard. No code change needed.
JIRA_JQL=project in (DTR)
# Optional: exact Jira query used by the Quality tab's QA Defects dashboard.
# Defaults to `(${JIRA_JQL}) AND issuetype = Bug`; set this to the saved filter JQL
# on the company Jira site if its defect scope or issue type differs.
JIRA_QA_DEFECT_JQL=
# Optional issue filters for defect lifecycle analysis. Leave blank to show N/A
# until your Jira workflow has a reliable UAT / escaped-defect classification.
JIRA_QA_UAT_DEFECT_JQL=
JIRA_QA_LEAKAGE_DEFECT_JQL=

# === Optional: Custom field IDs ===
# Custom field IDs are DIFFERENT on every Jira site. Run `pnpm discover:fields`
# to list them with sample values, then `pnpm probe` to confirm which is which.
JIRA_STORY_POINTS_FIELD=customfield_10078
# Optional override. By default, discover the Aha! URL field by name on the Jira site.
# JIRA_AHA_URL_FIELD=customfield_10280
JIRA_SPRINT_FIELD=customfield_10020
JIRA_POD_FIELD=customfield_10001

# === Optional: Which statuses count as "done" ===
# Comma-separated. Run `pnpm probe` to see the status names in use on your site.
JIRA_DONE_STATUSES=Done,Accepted,Released,Closed,Resolved
# Sub-tasks often use a simpler workflow than stories (e.g. Done vs Accepted).
# These statuses also count as complete for Developer View sub-tasks.
JIRA_SUBTASK_DONE_STATUSES=Done,Closed,Resolved,Completed,Released,Accepted

# === Optional: issue type used when sampling fields during discovery ===
JIRA_DISCOVERY_ISSUE_TYPE=Story

# === Optional: dashboard chart/refresh tuning ===
# Raw issues are cached in memory for this long (ms, default 5 min) so filter changes are instant.
JIRA_CACHE_TTL_MS=300000
# How many recent sprints to plot (oldest dropped). Default 5.
JIRA_SPRINT_WINDOW=5
# Show the next upcoming sprint only when the active sprint ends within this
# many days. Default 5.
JIRA_NEXT_SPRINT_REVEAL_DAYS=5
# ---- QA Team Capacity & Workload (Quality tab) ----
# Weekly capacity per member (default 40 = 8h x 5 days)
JIRA_QA_CAPACITY_HOURS_PER_WEEK=40
# Issue types Zephyr uses for test cases (comma-separated)
JIRA_QA_TEST_ISSUE_TYPES=Test
# Issue types counted as "supported load" (comma-separated)
JIRA_QA_SUPPORT_ISSUE_TYPES=Support
# Optional explicit QA member names, comma-separated (Jira displayName spelling).
# Leave empty to auto-detect members from assigned Test-type issues.
JIRA_QA_MEMBERS=
# Zephyr Essential Cloud v2.9 API access token (Bearer token). Keep it secret.
JIRA_ZEPHYR_API_TOKEN=
# Jira project keys whose Zephyr tests/executions should be included.
JIRA_ZEPHYR_PROJECT_KEYS=ENTQA

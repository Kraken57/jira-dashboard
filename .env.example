# === Required: Jira Cloud REST API credentials ===
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# NOTE: these are per-site AND per-machine. Each computer needs its own token
# for the Jira site it talks to.
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your-email-id
JIRA_API_TOKEN=your-jira-api-token

# === Optional: Base URL for API requests ===
# Leave blank for local Next.js /api routes
NEXT_PUBLIC_API_BASE_URL=

# === Optional: Which Jira data to pull ===
# Change project keys to point at a different dashboard. No code change needed.
JIRA_JQL=project in (DTR)

# === Optional: Custom field IDs ===
# Custom field IDs are DIFFERENT on every Jira site. Run `pnpm discover:fields`
# to list them with sample values, then `pnpm probe` to confirm which is which.
JIRA_STORY_POINTS_FIELD=customfield_10078
JIRA_SPRINT_FIELD=customfield_10020
JIRA_POD_FIELD=customfield_10001

# === Optional: Which statuses count as "done" ===
# Comma-separated. Run `pnpm probe` to see the status names in use on your site.
JIRA_DONE_STATUSES=Done,Accepted,Released,Closed,Resolved

# === Optional: issue type used when sampling fields during discovery ===
JIRA_DISCOVERY_ISSUE_TYPE=Story

# === Optional: dashboard chart/refresh tuning ===
# Raw issues are cached in memory for this long (ms, default 5 min) so filter changes are instant.
JIRA_CACHE_TTL_MS=300000
# How many recent sprints to plot (oldest dropped). Default 5.
JIRA_SPRINT_WINDOW=5
# Show the next upcoming sprint only when the active sprint ends within this
# many days. Default 5.
JIRA_NEXT_SPRINT_REVEAL_DAYS=5
